+// clang lacks GCC's __builtin_shuffle and forbids taking the address of a vector
+// element.  Scalar equivalents for the non-AVX2 fallback path (macOS/arm64 port).
+template <typename V, typename M>
+static inline V g6k_shuffle(const V a, const M m) {
+  constexpr unsigned N = sizeof(V) / sizeof(a[0]);
+  V r;
+  for (unsigned i = 0; i < N; i++) r[i] = a[m[i] & (N - 1)];
+  return r;
+}
+template <typename V, typename M>
+static inline V g6k_shuffle(const V a, const V b, const M m) {
+  constexpr unsigned N = sizeof(V) / sizeof(a[0]);
+  V r;
+  for (unsigned i = 0; i < N; i++) {
+    const unsigned j = m[i] & (2 * N - 1);
+    r[i] = j < N ? a[j] : b[j - N];
+  }
+  return r;
+}
+#define G6K_SHUFFLE g6k_shuffle
+#define G6K_ELEM_PTR(v, i) ((void *)((char *)&(v) + (i) * sizeof((v)[0])))
+#else
+#define G6K_SHUFFLE __builtin_shuffle
+#define G6K_ELEM_PTR(v, i) ((void *)&(v)[i])
